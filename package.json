{
  "name": "iet-ui-testtaker",
  "version": "0.1.0",
  "description": "IDP English Test - Test Taker Portal MVP",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --ext .ts,.tsx,.jsx,.js",
    "lint:fix": "eslint src tests --ext .ts,.tsx,.jsx,.js --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,css,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,css,json,md}'",
    "test": "jest --watch",
    "test:run": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.config.integration.cjs",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.infra.json",
    "cdk": "node --env-file-if-exists=.env node_modules/aws-cdk/bin/cdk",
    "synth:dev": "npm run cdk -- synth -c stage=dev",
    "diff:dev": "node -e \"require('fs').existsSync('dist/index.html') || require('child_process').execSync('npm run build', { stdio: 'inherit' })\" && npm run cdk -- diff -c stage=dev",
    "diff:sit": "npm run cdk -- diff -c stage=sit",
    "diff:uat": "npm run cdk -- diff -c stage=uat",
    "diff:prod": "npm run cdk -- diff -c stage=prod",
    "deploy:dev": "npm run build && npm run cdk -- deploy --all -c stage=dev",
    "deploy:sit": "npm run build && npm run cdk -- deploy --all -c stage=sit",
    "deploy:uat": "npm run build && npm run cdk -- deploy --all -c stage=uat",
    "deploy:prod": "npm run build && npm run cdk -- deploy --all -c stage=prod",
    "destroy:dev": "npm run cdk -- destroy --all -c stage=dev"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "aws-amplify": "^6.22.2",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.7",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.6.2",
    "aws-cdk": "2.1146.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^1.3.0",
    "postcss": "^8.5.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vite": "^6.4.6"
  }
}
