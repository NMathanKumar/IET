{
  "name": "iet-ui-testtaker",
  "version": "0.1.0",
  "description": "IDP English Test - Test Taker Portal MVP",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx,.jsx,.js",
    "lint:fix": "eslint src --ext .ts,.tsx,.jsx,.js --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,css,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,css,json,md}'",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:ui": "vitest --ui --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.infra.json",
    "cdk": "node --env-file-if-exists=.env node_modules/aws-cdk/bin/cdk",
    "synth:dev": "npm run cdk -- synth -c stage=dev",
    "diff:dev": "npm run cdk -- diff -c stage=dev",
    "diff:sit": "npm run cdk -- diff -c stage=sit",
    "diff:uat": "npm run cdk -- diff -c stage=uat",
    "diff:prod": "npm run cdk -- diff -c stage=prod",
    "deploy:dev": "npm run build && npm run cdk -- deploy --all -c stage=dev",
    "deploy:sit": "npm run build && npm run cdk -- deploy --all -c stage=sit",
    "deploy:uat": "npm run build && npm run cdk -- deploy --all -c stage=uat",
    "deploy:prod": "npm run build && npm run cdk -- deploy --all -c stage=prod",
    "destroy:dev": "npm run cdk -- destroy --all -c stage=dev"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "aws-amplify": "^6.22.2",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "1.6.1",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.6.2",
    "aws-cdk": "2.1146.0",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.0.0",
    "msw": "^1.3.0",
    "postcss": "^8.5.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
